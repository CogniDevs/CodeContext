{
	"rules": {
		"c_style": {
			"extensions": [
				".js",
				".jsx",
				".ts",
				".tsx",
				".c",
				".cpp",
				".h",
				".hpp",
				".go",
				".rs",
				".java",
				".cs",
				".php",
				".css",
				".scss",
				".dart",
				".kt",
				".kts"
			],
			"pattern": "(\"(?:\\\\.|[^\"\\\\])*\")|('(?:\\\\.|[^'\\\\])*')|(//.*?$)|(/\\*[\\s\\S]*?\\*/)"
		},
		"python_style": {
			"extensions": [".py", ".ipynb"],
			"hash_pattern": "(\"(?:\\\\.|[^\"\\\\])*\")|('(?:\\\\.|[^'\\\\])*')|(#.*?$)",
			"docstring_pattern": "^\\s*(\"\"\"[\\s\\S]*?\"\"\"|'''[\\s\\S]*?''')\\s*$"
		},
		"xml_style": {
			"extensions": [
				".html",
				".xml",
				".svelte",
				".vue",
				".astro",
				".svg"
			],
			"pattern": "(\"(?:\\\\.|[^\"\\\\])*\")|('(?:\\\\.|[^'\\\\])*')|(<!--[\\s\\S]*?-->)"
		},
		"hash_style": {
			"extensions": [
				".sh",
				".bash",
				".yaml",
				".yml",
				".toml",
				".ini",
				"makefile",
				"dockerfile",
				".rb"
			],
			"pattern": "(\"(?:\\\\.|[^\"\\\\])*\")|('(?:\\\\.|[^'\\\\])*')|(#.*?$)"
		},
		"sql_style": {
			"extensions": [".sql"],
			"pattern": "(\"(?:\\\\.|[^\"\\\\])*\")|('(?:\\\\.|[^'\\\\])*')|(--.*?$)|(/\\*[\\s\\S]*?\\*/)"
		}
	}
}