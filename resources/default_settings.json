{
  "xml_format": true,
  "strip_comments": false,
  "compress_whitespace": false,
  "sanitize_secrets": false,
  "use_gitignore": true,
  "ignore_binary": true,
  "ignore_lockfiles": true,
  "auto_check_updates": true,
  "auto_watch": true,
  "always_send_full_tree": true,
  "theme": "Темная (VS Code)",
  "selected_preset": "Все текстовые файлы (без ограничений)",
  "global_excludes": [
    ".git",
    ".git-hooks",
    ".github",
    ".gitlab",
    ".idea",
    ".vscode",
    ".devcontainer",
    "node_modules",
    "bower_components",
    ".angular",
    ".svelte-kit",
    ".next",
    ".vite",
    ".nuxt",
    ".cache",
    "build",
    "dist",
    "out",
    "target",
    "__pycache__",
    ".venv",
    "venv",
    "env",
    "tmp",
    "coverage"
  ],
  "binary_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".pdf",
    ".exe",
    ".dll",
    ".bin",
    ".zip",
    ".tar",
    ".gz",
    ".rar",
    ".7z",
    ".mp3",
    ".mp4",
    ".wav",
    ".avi",
    ".mov",
    ".woff",
    ".woff2",
    ".ttf",
    ".db",
    ".sqlite",
    ".sqlite3",
    ".dmg",
    ".iso",
    ".msi",
    ".class",
    ".pyc",
    ".o",
    ".obj",
    ".so",
    ".dylib",
    ".svg"
  ],
  "lockfiles_excludes": [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "go.sum",
    "Cargo.lock",
    "LICENSE"
  ],
  "active_extensions": [],
  "all_known_extensions": [
    ".py",
    ".ipynb",
    ".csv",
    ".go",
    ".svelte",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".vue",
    ".astro",
    ".css",
    ".html",
    ".json",
    ".md",
    ".toml",
    ".yaml",
    ".yml",
    ".ini",
    ".txt",
    ".rs",
    ".cpp",
    ".hpp",
    ".c",
    ".h",
    ".cmake",
    ".java",
    ".kt",
    ".kts",
    ".xml",
    ".gradle",
    ".properties",
    ".cs",
    ".csproj",
    ".sln",
    ".shader",
    ".cginc",
    ".hlsl",
    ".php",
    ".dart",
    ".rb",
    ".ru",
    ".sh",
    ".bash",
    ".tf",
    ".tfvars",
    ".sql",
    ".plist",
    ".m"
  ],
  "presets": {
    "Все текстовые файлы (без ограничений)": [],
    "Python (Data Science, Web, FastApi)": [
      ".py",
      ".ipynb",
      ".csv",
      ".json",
      ".yaml",
      ".yml",
      ".md",
      ".txt",
      ".toml"
    ],
    "Rust (Systems / WebAssembly)": [
      ".rs",
      ".toml",
      ".md",
      ".json",
      ".yaml",
      ".yml"
    ],
    "React / Angular / Vue / Node.js": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".css",
      ".scss",
      ".html",
      ".json",
      ".md"
    ]
  }
}