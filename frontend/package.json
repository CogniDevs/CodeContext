{
  "name": "codecontext-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "copy:assets": "node copy-assets.js",
    "build:wasm": "cd ../codecontext_core && wasm-pack build --target web --out-dir pkg -- --features wasm && node -e \"try{require('fs').unlinkSync('pkg/.gitignore')}catch(e){}\"",
    "prebuild": "npm run build:wasm && npm run copy:assets",
    "prestart": "npm run copy:assets",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "codecontext_core": "file:../codecontext_core/pkg",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "typescript": "^6.0.0"
  }
}
